@model ApiProjeKampi.WebUI.Dtos.AboutDtos.GetAboutByIdDto

@{
    ViewData["Title"] = "Hakkımızda Güncelle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<style>
    .about-upload {
        background: #f8f9ff;
        border: 2px dashed #667eea;
        border-radius: 12px;
        padding: 20px;
    }

        .about-upload input[type="file"] {
            display: block !important;
            width: 100%;
            padding: 10px;
            background: white;
            border: 1px solid #ddd;
            border-radius: 8px;
        }

    .about-preview {
        max-width: 100%;
        width: 260px;
        height: 180px;
        object-fit: cover;
        border-radius: 10px;
        margin-top: 15px;
    }
</style>

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Hakkımızda Alanı Güncelleme</h4>
                    </div>

                    <div class="card-body">
                        <form id="aboutForm"
                              action="/About/UpdateAbout"
                              method="post"
                              enctype="multipart/form-data"
                              novalidate>

                            @Html.AntiForgeryToken()

                            <input type="hidden" asp-for="AboutId" />

                            <input type="hidden"
                                   id="RemoveImage"
                                   name="removeImage"
                                   value="false" />

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3"></div>

                            <div class="form-group">
                                <label>Başlık</label>
                                <input asp-for="Title"
                                       class="form-control" />
                            </div>

                            <div class="form-group">
                                <label>Rezervasyon Numarası</label>
                                <input asp-for="ReservationNumber"
                                       class="form-control" />
                            </div>

                            <div class="form-group">
                                <label>Açıklama</label>
                                <textarea asp-for="Description"
                                          rows="5"
                                          class="form-control"></textarea>
                            </div>

                            <div class="form-group">
                                <label>Hakkımızda Görseli</label>

                                <div id="currentImageArea">
                                    @if (!string.IsNullOrWhiteSpace(Model?.ImageUrl))
                                    {
                                        <img src="@Model.ImageUrl"
                                             class="about-preview"
                                             alt="Mevcut Hakkımızda görseli" />
                                    }
                                    else
                                    {
                                        <p class="text-muted">
                                            Henüz görsel bulunmuyor.
                                        </p>
                                    }
                                </div>

                                <div class="about-upload mt-3">
                                    <label for="imageFile">
                                        Başka Fotoğraf Seç
                                    </label>

                                    <input type="file"
                                           id="imageFile"
                                           name="imageFile"
                                           accept=".jpg,.jpeg,.png,.webp" />

                                    <small class="text-muted">
                                        JPG, PNG veya WEBP. En fazla 5 MB.
                                        Yeni fotoğraf seçmezsen eskisi korunur.
                                    </small>

                                    <div class="text-danger mt-2">
                                        @Html.ValidationMessage("imageFile")
                                    </div>

                                    <div>
                                        <img id="imagePreview"
                                             class="about-preview"
                                             alt="Yeni görsel önizleme"
                                             style="display:none;" />
                                    </div>

                                    <div class="mt-3">
                                        <button type="button"
                                                id="deleteImageBtn"
                                                class="btn btn-danger">
                                            <i class="fas fa-trash"></i>
                                            Fotoğrafı Sil
                                        </button>

                                        <button type="button"
                                                id="restoreImageBtn"
                                                class="btn btn-outline-secondary"
                                                style="display:none;">
                                            <i class="fas fa-undo"></i>
                                            Geri Al
                                        </button>
                                    </div>

                                    <p id="imageStatus"
                                       class="text-muted mt-2"
                                       aria-live="polite"></p>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i>
                                Hakkımızda Alanını Güncelle
                            </button>

                            <a href="/About/AboutList"
                               class="btn btn-secondary">
                                Geri Dön
                            </a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    (function () {
        const form = document.getElementById("aboutForm");
        const input = document.getElementById("imageFile");
        const preview = document.getElementById("imagePreview");
        const currentArea = document.getElementById("currentImageArea");
        const removeField = document.getElementById("RemoveImage");
        const deleteBtn = document.getElementById("deleteImageBtn");
        const restoreBtn = document.getElementById("restoreImageBtn");
        const status = document.getElementById("imageStatus");

        const hadImage = @Json.Serialize(
                        !string.IsNullOrWhiteSpace(Model?.ImageUrl)
                );

        let objectUrl = null;

        function warning(message) {
            if (typeof Swal !== "undefined") {
                Swal.fire({
                    icon: "warning",
                    title: "Eksik veya Hatalı Bilgi",
                    text: message,
                    confirmButtonText: "Tamam"
                });
            } else {
                alert(message);
            }
        }

        function clearPreview() {
            if (objectUrl) {
                URL.revokeObjectURL(objectUrl);
                objectUrl = null;
            }

            preview.removeAttribute("src");
            preview.style.display = "none";
        }

        input.addEventListener("change", function () {
            const file = input.files[0];
            if (!file) return;

            const extension = file.name.split(".").pop().toLowerCase();

            if (!["jpg", "jpeg", "png", "webp"].includes(extension)) {
                warning("Yalnızca JPG, PNG veya WEBP fotoğraf seçebilirsiniz.");
                input.value = "";
                return;
            }

            if (file.size > 5 * 1024 * 1024) {
                warning("Fotoğraf en fazla 5 MB olabilir.");
                input.value = "";
                return;
            }

            clearPreview();

            objectUrl = URL.createObjectURL(file);
            preview.src = objectUrl;
            preview.style.display = "block";

            currentArea.style.display = "none";
            removeField.value = "false";
            restoreBtn.style.display = "inline-block";

            status.textContent =
                "Yeni fotoğraf seçildi. Güncelle dediğinizde kaydedilecek.";
        });

        deleteBtn.addEventListener("click", function () {
            input.value = "";
            clearPreview();

            currentArea.style.display = "none";
            removeField.value = "true";
            restoreBtn.style.display = "inline-block";

            status.textContent =
                "Fotoğraf kaldırıldı. Kaydetmek için yeni fotoğraf seçmelisiniz.";
        });

        restoreBtn.addEventListener("click", function () {
            input.value = "";
            clearPreview();

            currentArea.style.display = "block";
            removeField.value = "false";
            restoreBtn.style.display = "none";

            status.textContent = "Mevcut fotoğraf korunacak.";
        });

        form.addEventListener("submit", function (event) {
            const title = document.getElementById("Title").value.trim();
            const description =
                document.getElementById("Description").value.trim();

            const hasNewImage = input.files.length > 0;
            const hasOldImage =
                hadImage && removeField.value !== "true";

            let message = "";

            if (!title)
                message = "Lütfen başlık giriniz.";
            else if (!description)
                message = "Lütfen açıklama giriniz.";
            else if (!hasNewImage && !hasOldImage)
                message = "Fotoğraf boş bırakılamaz. Yeni fotoğraf seçiniz veya Geri Al'a basınız.";

            if (message) {
                event.preventDefault();
                warning(message);
            }
        });
    })();
</script>
