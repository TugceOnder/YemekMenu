@model List<ApiProjeKampi.WebUI.Dtos.AboutDtos.ResultAboutDto>

@{
    ViewData["Title"] = "AboutList";
    Layout = "~/Views/AdminLayout/Index.cshtml";

    var abouts = Model ??
        new List<ApiProjeKampi.WebUI.Dtos.AboutDtos.ResultAboutDto>();
}

<link rel="stylesheet"
      href="~/css/PartialStyle.css"
      asp-append-version="true" />


<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">

                <div class="card modern-card">

                    <!-- KART BAŞLIĞI -->
                    <div class="card-header"
                         style="background:white;
                                border-bottom:2px solid #f0f0f0;
                                border-radius:15px 15px 0 0;">

                        <h4 style="color:#667eea;
                                   font-weight:700;
                                   margin:0;">

                            <i class="fas fa-info-circle"
                               style="margin-right:10px;"></i>

                            Hakkımda Sayfası Listesi
                        </h4>

                        <div class="card-header-action">
                            <a href="/About/CreateAbout/"
                               class="modern-btn btn-create">

                                <i class="fas fa-plus"></i>
                                Yeni Hakkımda Alanı Ekle
                            </a>
                        </div>
                    </div>

                    <!-- TABLO -->
                    <div class="card-body" style="padding:0;">
                        <div class="table-responsive">

                            <table class="table modern-table">
                                <thead>
                                    <tr>
                                        <th scope="col"
                                            style="width:5%;">
                                        </th>

                                        <th scope="col"
                                            style="width:20%;">
                                            Başlık
                                        </th>

                                        <th scope="col"
                                            style="width:45%;">
                                            Açıklama
                                        </th>

                                        <th scope="col"
                                            style="width:30%;"
                                            class="text-center">
                                            İşlemler
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in abouts)
                                    {
                                        <tr>
                                            <!-- İKON -->
                                            <td>
                                                <div class="about-icon">
                                                    <i class="fas fa-file-alt"></i>
                                                </div>
                                            </td>

                                            <!-- BAŞLIK -->
                                            <td>
                                                <span class="title-badge">
                                                    <i class="fas fa-heading"></i>
                                                    @item.Title
                                                </span>
                                            </td>

                                            <!-- AÇIKLAMA -->
                                            <td>
                                                <div class="description-box">
                                                    @item.Description
                                                </div>
                                            </td>

                                            <!-- İŞLEMLER -->
                                            <td class="text-center about-action-cell">

                                                <div class="about-actions">

                                                    <!-- GÖRÜNTÜLE -->
                                                    <button type="button"
                                                            class="modern-btn btn-view js-view-about"
                                                            data-id="@item.AboutId"
                                                            data-title="@item.Title"
                                                            data-description="@item.Description"
                                                            data-image="@item.ImageUrl"
                                                            data-reservation="@item.ReservationNumber"
                                                            title="Görüntüle">

                                                        <i class="fas fa-eye"></i>
                                                        Görüntüle
                                                    </button>

                                                    <!-- DÜZENLE -->
                                                    <a href="/About/UpdateAbout/@item.AboutId/"
                                                       class="modern-btn btn-edit"
                                                       title="Düzenle">

                                                        <i class="fas fa-edit"></i>
                                                        Düzenle
                                                    </a>

                                                    <!-- SİL -->
                                                    <a href="/About/DeleteAbout/@item.AboutId/"
                                                       class="modern-btn btn-delete"
                                                       title="Sil"
                                                       onclick="return confirm('Bu hakkımda alanını silmek istediğinize emin misiniz?');">

                                                        <i class="fas fa-trash-alt"></i>
                                                        Sil
                                                    </a>

                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                        </div>
                    </div>

                    <!-- ALT BİLGİ -->
                    <div class="card-footer"
                         style="background:white;
                                border-top:2px solid #f0f0f0;">

                        <div style="color:#999;
                                    font-size:0.875rem;">

                            <i class="fas fa-info-circle"></i>

                            Toplam

                            <strong style="color:#667eea;">
                                @abouts.Count
                            </strong>

                            hakkımda kaydı listelendi.
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    document.querySelectorAll(".js-view-about").forEach(function (button) {

        button.addEventListener("click", function () {

            const title = this.dataset.title || "";
            const description = this.dataset.description || "";
            const reservation = this.dataset.reservation || "";
            const imageUrl = this.dataset.image || "";

            const container = document.createElement("div");
            container.className = "about-detail";

            // FOTOĞRAF
            if (imageUrl.trim()) {

                const image = document.createElement("img");

                image.src = imageUrl;
                image.alt = title || "Hakkımızda görseli";
                image.className = "about-detail-image";

                image.onerror = function () {
                    image.remove();
                };

                container.appendChild(image);
            }

            // DETAY SATIRI
            function addDetail(label, value) {

                const row = document.createElement("div");
                row.className = "about-detail-row";

                const labelElement = document.createElement("span");
                labelElement.className = "about-detail-label";
                labelElement.textContent = label;

                const valueElement = document.createElement("p");
                valueElement.className = "about-detail-value";
                valueElement.textContent = value || "Belirtilmemiş";

                row.appendChild(labelElement);
                row.appendChild(valueElement);

                container.appendChild(row);
            }

            addDetail("Başlık", title);
            addDetail("Açıklama", description);
            addDetail("Rezervasyon Numarası", reservation);

            // SWEETALERT
            if (typeof Swal !== "undefined") {

                Swal.fire({
                    title: "Hakkımızda Detayları",
                    html: container,
                    icon: "info",
                    width: 650,
                    confirmButtonText: "Kapat",
                    confirmButtonColor: "#667eea"
                });

            } else {

                alert(
                    "Başlık: " + title + "\n\n" +
                    "Açıklama: " + description + "\n\n" +
                    "Rezervasyon Numarası: " + reservation
                );
            }

        });

    });
</script>
