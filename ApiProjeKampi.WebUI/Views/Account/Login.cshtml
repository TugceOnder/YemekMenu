@model ApiProjeKampi.WebUI.Models.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Giriş Yap</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            background-color: #f8f9fa;
            font-family: Arial, sans-serif;
        }

        .login-container {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .login-card {
            width: 100%;
            max-width: 430px;
            background: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 5px 25px rgba(0, 0, 0, 0.10);
        }

        .login-title {
            text-align: center;
            margin-bottom: 30px;
        }

            .login-title h2 {
                font-weight: 700;
            }

            .login-title p {
                color: #777;
            }

        .form-control {
            height: 50px;
            border-radius: 8px;
        }

        .login-btn {
            height: 50px;
            border-radius: 8px;
            background-color: #ce1212;
            border: none;
            font-weight: 600;
        }

            .login-btn:hover {
                background-color: #a70f0f;
            }

        .register-link {
            text-align: center;
            margin-top: 20px;
        }

            .register-link a {
                color: #ce1212;
                text-decoration: none;
                font-weight: 600;
            }
    </style>
</head>

<body>

    <div class="login-container">

        <div class="login-card">

            <div class="login-title">
                <h2>Giriş Yap</h2>
                <p>Yönetim paneline giriş yapın</p>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            <form asp-controller="Account"
                  asp-action="Login"
                  method="post">

                <div class="mb-3">
                    <label class="form-label">Kullanıcı Adı</label>

                    <input asp-for="UserName"
                           class="form-control"
                           placeholder="Kullanıcı adınızı giriniz" />
                </div>

                <div class="mb-4">
                    <label class="form-label">Şifre</label>

                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           placeholder="Şifrenizi giriniz" />
                </div>

                <button type="submit"
                        class="btn btn-danger login-btn w-100">
                    Giriş Yap
                </button>

            </form>

            <div class="register-link">
                Hesabınız yok mu?

                <a asp-controller="Account"
                   asp-action="Register">
                    Hesap Oluştur
                </a>
            </div>

        </div>

    </div>

</body>
</html>