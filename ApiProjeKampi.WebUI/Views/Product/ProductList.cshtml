@model List<ApiProjeKampi.WebUI.Dtos.ProductDtos.ResultProductDto>

@{
    ViewData["Title"] = "ProductList";
    Layout = "~/Views/AdminLayout/Index.cshtml";

    var products = Model ??
        new List<ApiProjeKampi.WebUI.Dtos.ProductDtos.ResultProductDto>();

    int count = 0;
}

<link rel="stylesheet"
      href="~/css/PartialStyle.css"
      asp-append-version="true" />



<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">

                <!-- SIRALAMA GÜVENLİK ANAHTARI -->
                <form id="productOrderTokenForm" method="post">
                    @Html.AntiForgeryToken()
                </form>

                <div id="orderMessage"
                     role="status"
                     aria-live="polite"></div>

                <div class="card modern-card">

                    <!-- BAŞLIK -->
                    <div class="card-header"
                         style="background:white;
                                border-bottom:2px solid #f0f0f0;
                                border-radius:15px 15px 0 0;">

                        <h4 style="color:#667eea;
                                   font-weight:700;
                                   margin:0;">

                            <i class="fas fa-box-open"
                               style="margin-right:10px;"></i>

                            Ürün Listesi Yönetimi
                        </h4>

                        <div class="card-header-action">
                            <a href="/Product/CreateProduct/"
                               class="modern-btn btn-create">

                                <i class="fas fa-plus"></i>
                                Yeni Ürün Ekle
                            </a>
                        </div>
                    </div>

                    <!-- TABLO -->
                    <div class="card-body" style="padding:0;">
                        <div class="table-responsive">

                            <table class="table modern-table">

                                <thead>
                                    <tr>
                                        <th style="width:8%;">#</th>
                                        <th style="width:6%;"></th>
                                        <th style="width:20%;">Ürün Adı</th>
                                        <th style="width:12%;">Fiyat</th>
                                        <th style="width:12%;">Kategori</th>
                                    
                                        <th style="width:34%;"
                                            class="text-center">
                                            İşlemler
                                        </th>
                                    </tr>
                                </thead>

                                <tbody id="sortableProducts">

                                    @foreach (var item in products)
                                    {
                                        count++;

                                        @* ResultProductDto içinde ImageUrl
                                           tanımlıysa görseli alır.
                                           Tanımlı değilse hata vermez. *@
                                        var imageUrl = item.GetType()
                                        .GetProperty("ImageUrl")
                                        ?.GetValue(item)?.ToString() ?? "";

                                        <tr data-id="@item.ProductId">

                                            <!-- SIRA NUMARASI -->
                                            <td>
                                                <span class="drag-handle"
                                                      title="Sürükleyerek sırala">
                                                    <i class="fas fa-grip-vertical"></i>
                                                </span>

                                                <strong class="row-number">
                                                    @count
                                                </strong>
                                            </td>

                                            <!-- ÜRÜN İKONU -->
                                            <td>
                                                <div class="product-icon">
                                                    <i class="fas fa-utensils"></i>
                                                </div>
                                            </td>

                                            <!-- ÜRÜN ADI -->
                                            <td>
                                                <strong style="color:#333;
                                                                   font-size:1rem;">
                                                    @item.ProductName
                                                </strong>

                                                <br />

                                                <small style="color:#999;">
                                                    Ürün ID: #@item.ProductId
                                                </small>
                                            </td>

                                            <!-- FİYAT -->
                                            <td>
                                                <span class="price-badge">
                                                    <i class="fas fa-lira-sign"></i>
                                                    @item.Price.ToString("N2")
                                                </span>
                                            </td>

                                            <!-- KATEGORİ -->
                                            <td>
                                                <span class="category-tag">
                                                    <i class="fas fa-tag"></i>
                                                    @item.CategoryName
                                                </span>
                                            </td>

                                            <!-- STOK -->
                                           

                                            <!-- İŞLEMLER -->
                                            <td class="text-center product-action-cell">

                                                <div class="product-actions">

                                                    <!-- GÖRÜNTÜLE -->
                                                    <button type="button"
                                                            class="modern-btn btn-view js-view-product"
                                                            data-id="@item.ProductId"
                                                            data-name="@item.ProductName"
                                                            data-price="@item.Price.ToString("N2")"
                                                            data-category="@item.CategoryName"
                                                            data-image="@imageUrl"
                                                            title="Görüntüle">

                                                        <i class="fas fa-eye"></i>
                                                        Görüntüle
                                                    </button>

                                                    <!-- DÜZENLE -->
                                                    <a href="/Product/UpdateProduct/@item.ProductId/"
                                                       class="modern-btn btn-edit"
                                                       title="Düzenle">

                                                        <i class="fas fa-edit"></i>
                                                        Düzenle
                                                    </a>

                                                    <!-- SİL -->
                                                    <a href="/Product/DeleteProduct/@item.ProductId/"
                                                       class="modern-btn btn-delete"
                                                       title="Sil"
                                                       onclick="return confirm('Bu ürünü silmek istediğinize emin misiniz?');">

                                                        <i class="fas fa-trash-alt"></i>
                                                        Sil
                                                    </a>

                                                </div>
                                            </td>
                                        </tr>
                                    }

                                    @if (products.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="7"
                                                class="text-center text-muted"
                                                style="padding:30px;">
                                                Görüntülenecek ürün bulunamadı.
                                            </td>
                                        </tr>
                                    }

                                </tbody>
                            </table>

                        </div>
                    </div>

                    <!-- ALT BİLGİ -->
                    <div class="card-footer"
                         style="background:white;
                                border-top:2px solid #f0f0f0;">

                        <div style="color:#999; font-size:0.875rem;">

                            <i class="fas fa-info-circle"></i>

                            Toplam
                            <strong style="color:#667eea;">
                                @products.Count
                            </strong>
                            ürün listelendi.

                            <span style="margin-left:12px;">
                                <i class="fas fa-arrows-alt-v"></i>
                                Sıralamak için taşıma ikonunu sürükleyin.
                            </span>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

<!-- SWEETALERT -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- SORTABLE JS -->
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>

<script>
    (function () {

        // ==================================
        // 1. GÖRÜNTÜLE - SWEETALERT
        // ==================================

        document.querySelectorAll(".js-view-product").forEach(function (button) {

            button.addEventListener("click", function () {

                const id = this.dataset.id || "";
                const name = this.dataset.name || "";
                const price = this.dataset.price || "";
                const category = this.dataset.category || "";
                const imageUrl = (this.dataset.image || "").trim();

                const container = document.createElement("div");
                container.className = "product-detail";

                // KÜÇÜK ÜRÜN FOTOĞRAFI
                if (imageUrl) {

                    const image = document.createElement("img");

                    image.src = imageUrl;
                    image.alt = name || "Ürün görseli";
                    image.className = "product-detail-image";

                    image.onerror = function () {
                        image.remove();
                    };

                    container.appendChild(image);
                }

                // DETAY SATIRI OLUŞTUR
                function addDetail(label, value) {

                    const row = document.createElement("div");
                    row.className = "product-detail-row";

                    const labelElement = document.createElement("span");
                    labelElement.className = "product-detail-label";
                    labelElement.textContent = label;

                    const valueElement = document.createElement("p");
                    valueElement.className = "product-detail-value";
                    valueElement.textContent = value || "Belirtilmemiş";

                    row.appendChild(labelElement);
                    row.appendChild(valueElement);

                    container.appendChild(row);
                }

                addDetail("Ürün Numarası", "#" + id);
                addDetail("Ürün Adı", name);
                addDetail("Fiyat", price + " TL");
                addDetail("Kategori", category);

                if (typeof Swal !== "undefined") {

                    Swal.fire({
                        title: "Ürün Detayları",
                        html: container,
                        icon: "info",
                        width: 480,
                        customClass: {
                            popup: "product-popup"
                        },
                        confirmButtonText: "Kapat",
                        confirmButtonColor: "#667eea"
                    });

                } else {

                    alert(
                        "Ürün: " + name + "\n\n" +
                        "Fiyat: " + price + " TL\n\n" +
                        "Kategori: " + category
                    );
                }
            });
        });


        // ==================================
        // 2. ÜRÜNLERİ SÜRÜKLE-BIRAK SIRALAMA
        // ==================================

        function initializeSorting() {

            const tbody = document.getElementById("sortableProducts");
            const message = document.getElementById("orderMessage");

            const token = document.querySelector(
                '#productOrderTokenForm input[name="__RequestVerificationToken"]'
            );

            if (!tbody) return;

            if (typeof Sortable === "undefined") {

                message.className = "alert alert-danger";
                message.textContent =
                    "Sürükle-bırak kütüphanesi yüklenemedi.";

                return;
            }

            const sortable = new Sortable(tbody, {

                animation: 200,
                draggable: "tr[data-id]",
                handle: ".drag-handle",

                ghostClass: "sortable-ghost",
                chosenClass: "sortable-chosen",

                onEnd: async function (evt) {

                    if (evt.oldIndex === evt.newIndex)
                        return;

                    sortable.option("disabled", true);

                    const rows = Array.from(
                        tbody.querySelectorAll("tr[data-id]")
                    );

                    // EKRANDAKİ SIRA NUMARALARINI GÜNCELLE
                    rows.forEach((row, index) => {

                        const number = row.querySelector(".row-number");

                        if (number)
                            number.textContent = index + 1;
                    });

                    const productIds = rows.map(
                        row => Number(row.dataset.id)
                    );

                    message.className = "alert alert-info";
                    message.textContent =
                        "Ürün sıralaması kaydediliyor...";

                    try {

                        if (!token) {
                            throw new Error(
                                "Güvenlik anahtarı bulunamadı."
                            );
                        }

                        const response = await fetch(
                            '@Url.Action("UpdateProductOrder", "Product")',
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type": "application/json",
                                    "RequestVerificationToken": token.value
                                },

                                body: JSON.stringify(productIds)
                            }
                        );

                        if (!response.ok) {

                            const errorText = await response.text();

                            throw new Error(
                                "HTTP " + response.status + ": " + errorText
                            );
                        }

                        message.className = "alert alert-success";
                        message.textContent =
                            "Ürün sıralaması başarıyla kaydedildi.";

                    } catch (error) {

                        console.error("Sıralama hatası:", error);

                        message.className = "alert alert-danger";
                        message.textContent =
                            "Sıralama kaydedilemedi: " + error.message;

                    } finally {

                        sortable.option("disabled", false);
                    }
                }
            });
        }

        if (document.readyState === "loading") {

            document.addEventListener(
                "DOMContentLoaded",
                initializeSorting
            );

        } else {

            initializeSorting();
        }

    })();
</script>
