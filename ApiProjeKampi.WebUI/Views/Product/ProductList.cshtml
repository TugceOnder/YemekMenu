@model List<ResultProductDto>
@{
    ViewData["Title"] = "ProductList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<link rel="stylesheet" href="~/css/PartialStyle.css" asp-append-version="true" />

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card modern-card">
                    <div class="card-header" style="background: white; border-bottom: 2px solid #f0f0f0; border-radius: 15px 15px 0 0;">
                        <h4 style="color: #667eea; font-weight: 700; margin: 0;">
                            <i class="fas fa-box-open" style="margin-right: 10px;"></i>
                            Ürün Listesi Yönetimi
                        </h4>
                        <div class="card-header-action">
                            <a href="/Product/CreateProduct/" class="modern-btn btn-create">
                                <i class="fas fa-plus"></i>
                                Yeni Ürün Ekle
                            </a>
                        </div>
                    </div>
                    <div class="card-body" style="padding: 0;">
                        <div class="table-responsive">
                            <table class="table modern-table">
                                <thead>
                                    <tr>
                                        <th scope="col" style="width: 5%;">#</th>
                                        <th scope="col" style="width: 5%;"></th>
                                        <th scope="col" style="width: 25%;">Ürün Adı</th>
                                        <th scope="col" style="width: 15%;">Fiyat</th>
                                        <th scope="col" style="width: 15%;">Kategori</th>
                                        <th scope="col" style="width: 10%;">Stok</th>
                                        <th scope="col" style="width: 25%;" class="text-center">İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        count++;
                                        <tr>
                                            <td><strong>@count</strong></td>
                                            <td>
                                                <div class="product-icon">
                                                    <i class="fas fa-utensils"></i>
                                                </div>
                                            </td>
                                            <td>
                                                <strong style="color: #333; font-size: 1rem;">@item.ProductName</strong>
                                                <br>
                                                <small style="color: #999;">Ürün ID: #@item.ProductId</small>
                                            </td>
                                            <td>
                                                <span class="price-badge">
                                                    <i class="fas fa-lira-sign"></i> @item.Price.ToString("N2")
                                                </span>
                                            </td>
                                            <td>
                                                <span class="category-tag">
                                                    <i class="fas fa-tag"></i> @item.CategoryName
                                                </span>
                                            </td>
                                            <td>
                                                <span style="background: #fff3cd; color: #856404; padding: 0.3rem 0.7rem; border-radius: 12px; font-size: 0.8rem; font-weight: 600;">
                                                    <i class="fas fa-cubes"></i> @Random.Shared.Next(10, 100)
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <div style="display: flex; gap: 0.5rem; justify-content: center;">
                                                    <a href="/Product/ViewProduct/@item.ProductId/" class="modern-btn btn-view" title="Görüntüle">
                                                        <i class="fas fa-eye"></i>
                                                        Görüntüle
                                                    </a>
                                                    <a href="/Product/UpdateProduct/@item.ProductId/" class="modern-btn btn-edit" title="Düzenle">
                                                        <i class="fas fa-edit"></i>
                                                        Düzenle
                                                    </a>
                                                    <a href="/Product/DeleteProduct/@item.ProductId/" class="modern-btn btn-delete" title="Sil" onclick="return confirm('Bu ürünü silmek istediğinize emin misiniz?');">
                                                        <i class="fas fa-trash-alt"></i>
                                                        Sil
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer" style="background: white; border-top: 2px solid #f0f0f0;">
                        <div style="color: #999; font-size: 0.875rem;">
                            <i class="fas fa-info-circle"></i>
                            Toplam <strong style="color: #667eea;">@Model.Count</strong> ürün listelendi
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>