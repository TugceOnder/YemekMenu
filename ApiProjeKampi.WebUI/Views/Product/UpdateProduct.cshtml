@using ApiProjeKampi.WebUI.Dtos.ProductDtos
@using Microsoft.AspNetCore.Mvc.Rendering
@model UpdateProductDto

@{
    ViewData["Title"] = "Ürün Güncelle";
    Layout = "~/Views/AdminLayout/Index.cshtml";

    var categories =
        ViewData["Categories"] as IEnumerable<SelectListItem>
        ?? Enumerable.Empty<SelectListItem>();

    var imageUrl = Model?.ImageUrl ?? "";
}

<style>
    .update-card {
        background: white;
        border-radius: 15px;
        border: none;
        box-shadow: 0 4px 20px rgba(0,0,0,.08);
        overflow: hidden;
    }

    .update-header {
        background: linear-gradient(135deg,#667eea,#764ba2);
        padding: 25px;
        color: white;
    }

        .update-header h4 {
            color: white;
            font-weight: 700;
            margin: 0;
        }

    .update-body {
        padding: 30px;
    }

    .update-label {
        font-weight: 600;
        margin-bottom: 8px;
        display: block;
    }

    .update-input {
        width: 100%;
        border: 1px solid #ddd;
        border-radius: 9px;
        padding: 12px;
    }

        .update-input:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102,126,234,.12);
        }

    .save-btn {
        background: #667eea;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 12px 25px;
        cursor: pointer;
    }

        .save-btn:hover {
            background: #5266cb;
        }

    .back-btn {
        background: #eee;
        color: #444;
        padding: 12px 25px;
        border-radius: 8px;
        text-decoration: none;
    }

    .preview-image {
        width: 160px;
        height: 130px;
        object-fit: cover;
        border-radius: 10px;
        margin-top: 12px;
        border: 1px solid #eee;
    }
</style>

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card update-card">

                    <div class="update-header">
                        <h4>
                            <i class="fas fa-edit"></i>
                            Ürün Güncelle
                        </h4>
                    </div>

                    <div class="update-body">

                        @if (Model == null)
                        {
                            <div class="alert alert-danger">
                                Ürün bilgileri yüklenemedi.
                            </div>

                            <a href="/Product/ProductList"
                               class="back-btn">
                                Ürün Listesine Dön
                            </a>
                        }
                        else
                        {
                            <form asp-controller="Product"
                                  asp-action="UpdateProduct"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       asp-for="ProductId" />

                                <div asp-validation-summary="All"
                                     class="text-danger mb-3"></div>

                                <div class="row">

                                    <div class="col-md-6 mb-3">
                                        <label asp-for="ProductName"
                                               class="update-label">
                                            Ürün Adı
                                        </label>

                                        <input asp-for="ProductName"
                                               class="update-input"
                                               required />

                                        <span asp-validation-for="ProductName"
                                              class="text-danger"></span>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Price"
                                               class="update-label">
                                            Fiyat (₺)
                                        </label>

                                        <input asp-for="Price"
                                               class="update-input"
                                               required />

                                        <span asp-validation-for="Price"
                                              class="text-danger"></span>
                                    </div>

                                    <div class="col-md-12 mb-3">
                                        <label asp-for="CategoryId"
                                               class="update-label">
                                            Kategori
                                        </label>

                                        <select asp-for="CategoryId"
                                                asp-items="categories"
                                                class="update-input"
                                                required>
                                            <option value="">
                                                Kategori Seçiniz
                                            </option>
                                        </select>

                                        <span asp-validation-for="CategoryId"
                                              class="text-danger"></span>
                                    </div>

                                    <div class="col-md-12 mb-3">
                                        <label asp-for="ProductDescription"
                                               class="update-label">
                                            Ürün Açıklaması
                                        </label>

                                        <textarea asp-for="ProductDescription"
                                                  rows="4"
                                                  class="update-input">
                                            </textarea>

                                        <span asp-validation-for="ProductDescription"
                                              class="text-danger"></span>
                                    </div>

                                    <div class="col-md-12 mb-3">
                                        <label asp-for="ImageUrl"
                                               class="update-label">
                                            Fotoğraf URL
                                        </label>

                                        <input asp-for="ImageUrl"
                                               id="imageUrl"
                                               class="update-input" />

                                        <span asp-validation-for="ImageUrl"
                                              class="text-danger"></span>

                                        <img id="imagePreview"
                                             src="@imageUrl"
                                             class="preview-image"
                                             alt="Ürün fotoğrafı"
                                             style="display:none;"
                                             onload="this.style.display='block'"
                                             onerror="this.style.display='none'" />
                                    </div>

                                </div>

                                <hr />

                                <div class="d-flex gap-3 flex-wrap">

                                    <button type="submit"
                                            class="save-btn">
                                        <i class="fas fa-save"></i>
                                        Değişiklikleri Kaydet
                                    </button>

                                    <a href="/Product/ProductList"
                                       class="back-btn">
                                        <i class="fas fa-arrow-left"></i>
                                        Geri Dön
                                    </a>

                                </div>

                            </form>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const input = document.getElementById("imageUrl");
        const preview = document.getElementById("imagePreview");

        if (!input || !preview) return;

        input.addEventListener("input", function () {
            const url = this.value.trim();

            preview.style.display = "none";

            if (url) {
                preview.src = url;
            } else {
                preview.removeAttribute("src");
            }
        });
    });
</script>
