@model List<ResultContactDto>
@{
    ViewData["Title"] = "ContactList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<link rel="stylesheet"
      href="~/css/PartialStyle.css"
      asp-append-version="true" />


<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card modern-card">
                    <div class="card-header" style="background: white; border-bottom: 2px solid #f0f0f0; border-radius: 15px 15px 0 0;">
                        <h4 style="color: #667eea; font-weight: 700; margin: 0;">
                            <i class="fas fa-address-book" style="margin-right: 10px;"></i>
                            İletişim Bilgileri Listesi
                        </h4>
                        <div class="card-header-action">
                            <a href="/Contact/CreateContact/" class="modern-btn btn-create">
                                <i class="fas fa-plus"></i>
                                Yeni İletişim Bilgisi Ekle
                            </a>
                        </div>
                    </div>
                    <div class="card-body" style="padding: 0;">
                        @if (Model.Count > 0)
                        {
                            <div class="contact-with-map">
                                <div>
                                    @foreach (var item in Model)
                                    {
                                        <div class="contact-info-card">
                                            <div class="contact-card-header">
                                                <h5>
                                                    <i class="fas fa-building"></i>
                                                    İletişim Bilgisi
                                                </h5>
                                            </div>
                                            <div class="contact-card-body">
                                                <div class="contact-info-item">
                                                    <div class="contact-icon">
                                                        <i class="fas fa-map-marker-alt"></i>
                                                    </div>
                                                    <div class="contact-info-content">
                                                        <div class="contact-info-label">Adres</div>
                                                        <div class="contact-info-value">@item.Address</div>
                                                    </div>
                                                </div>

                                                <div class="contact-info-item">
                                                    <div class="contact-icon">
                                                        <i class="fas fa-phone-alt"></i>
                                                    </div>
                                                    <div class="contact-info-content">
                                                        <div class="contact-info-label">Telefon</div>
                                                        <div class="contact-info-value">@item.Phone</div>
                                                    </div>
                                                </div>

                                                <div class="contact-info-item">
                                                    <div class="contact-icon">
                                                        <i class="fas fa-envelope"></i>
                                                    </div>
                                                    <div class="contact-info-content">
                                                        <div class="contact-info-label">E-posta</div>
                                                        <div class="contact-info-value">@item.Email</div>
                                                    </div>
                                                </div>

                                                <div class="contact-info-item">
                                                    <div class="contact-icon">
                                                        <i class="fas fa-clock"></i>
                                                    </div>
                                                    <div class="contact-info-content">
                                                        <div class="contact-info-label">Açık Saatler</div>
                                                        <div class="contact-info-value">@Html.Raw(item.OpenHours)</div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="contact-actions">
                                                <a href="/Contact/UpdateContact/@item.ContactId/" class="modern-btn btn-edit" title="Düzenle">
                                                    <i class="fas fa-edit"></i>
                                                    Düzenle
                                                </a>
                                                <a href="/Contact/DeleteContact/@item.ContactId/" class="modern-btn btn-delete" title="Sil" onclick="return confirm('Bu iletişim bilgisini silmek istediğinize emin misiniz?');">
                                                    <i class="fas fa-trash-alt"></i>
                                                    Sil
                                                </a>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="map-container">
                                    <div class="map-header">
                                        <h5>
                                            <i class="fas fa-map-marked-alt"></i>
                                            Konum
                                        </h5>
                                    </div>
                                    <iframe class="map-iframe"
                                            src="https://www.google.com/maps?q=37.1371198,27.3150481&z=16&output=embed"
                                            allowfullscreen=""
                                            loading="lazy"
                                            referrerpolicy="no-referrer-when-downgrade">
                                    </iframe>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="contact-cards-grid">
                                <div class="empty-state">
                                    <i class="fas fa-address-card"></i>
                                    <p>Henüz iletişim bilgisi eklenmemiş.</p>
                                    <a href="/Contact/CreateContact/" class="modern-btn btn-create" style="display: inline-flex; margin-top: 1rem;">
                                        <i class="fas fa-plus"></i>
                                        İlk İletişim Bilgisini Ekle
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="card-footer" style="background: white; border-top: 2px solid #f0f0f0;">
                        <div style="color: #999; font-size: 0.875rem;">
                            <i class="fas fa-info-circle"></i>
                            Toplam <strong style="color: #667eea;">@Model.Count</strong> iletişim bilgisi listelendi
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>