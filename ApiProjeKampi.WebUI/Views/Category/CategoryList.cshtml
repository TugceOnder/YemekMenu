@model List<ApiProjeKampi.WebUI.Dtos.CategoryDtos.ResultCategoryDto>

@{
    ViewData["Title"] = "Kategori Yönetimi";
    Layout = "~/Views/AdminLayout/Index.cshtml";

    var categories = Model ??
        new List<ApiProjeKampi.WebUI.Dtos.CategoryDtos.ResultCategoryDto>();

    var productCounts =
        ViewBag.ProductCounts as Dictionary<int, int>
        ?? new Dictionary<int, int>();
}

<link rel="stylesheet"
      href="~/css/PartialStyle.css"
      asp-append-version="true" />
<link rel="stylesheet" href="~/css/PartialStyle.css" asp-append-version="true" />


<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">

                <form id="orderTokenForm" method="post">
                    @Html.AntiForgeryToken()
                </form>

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-triangle"></i>
                        @TempData["Error"]
                    </div>
                }

                <div class="sort-info">
                    <i class="fas fa-info-circle"></i>
                    Kategorileri sıralamak için soldaki taşıma simgesini
                    tutup yukarı veya aşağı sürükleyebilirsiniz.
                </div>

                <div id="orderMessage"
                     role="status"
                     aria-live="polite"></div>

                <div class="card modern-card">

                    <div class="card-header"
                         style="background:white;padding:20px;">

                        <h4 style="color:#667eea;font-weight:700;margin:0;">
                            <i class="fas fa-list-ul"></i>
                            Kategori Yönetimi
                        </h4>

                        <div class="card-header-action">
                            <a href="/Category/CreateCategory"
                               class="modern-btn btn-create">
                                <i class="fas fa-plus"></i>
                                Yeni Kategori
                            </a>
                        </div>
                    </div>

                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table modern-table">
                                <thead>
                                    <tr>
                                        <th>Sıra</th>
                                        <th></th>
                                        <th>Kategori Adı</th>
                                        <th>Durum</th>
                                        <th>Ürün Sayısı</th>
                                        <th class="text-center">İşlemler</th>
                                    </tr>
                                </thead>

                                <tbody id="sortableCategories">

                                    @if (categories.Count > 0)
                                    {
                                        for (int i = 0; i < categories.Count; i++)
                                        {
                                            var item = categories[i];

                                            var productCount =
                                            productCounts.TryGetValue(
                                            item.CategoryId,
                                            out var adet)
                                            ? adet : 0;

                                            <tr data-id="@item.CategoryId">

                                                <td>
                                                    <span class="drag-handle"
                                                          title="Sürükleyerek sırala">
                                                        <i class="fas fa-grip-vertical"></i>
                                                    </span>

                                                    <strong class="row-number">
                                                        @(i + 1)
                                                    </strong>
                                                </td>

                                                <td>
                                                    <div class="category-icon">
                                                        <i class="fas fa-tag"></i>
                                                    </div>
                                                </td>

                                                <td>
                                                    <strong>
                                                        @item.CategoryName
                                                    </strong>
                                                </td>

                                                <td>
                                                    <span class="badge-status badge-active">
                                                        <i class="fas fa-check-circle"></i>
                                                        Aktif
                                                    </span>
                                                </td>

                                                <td>
                                                    <span class="stats-badge">
                                                        <i class="fas fa-box"></i>
                                                        @productCount ürün
                                                    </span>
                                                </td>

                                                <td class="text-center">
                                                    <div class="action-buttons">

                                                        <a href="/Category/ViewCategory/@item.CategoryId"
                                                           class="modern-btn btn-view">
                                                            <i class="fas fa-eye"></i>
                                                            Görüntüle
                                                        </a>

                                                        <a href="/Category/UpdateCategory/@item.CategoryId"
                                                           class="modern-btn btn-edit">
                                                            <i class="fas fa-edit"></i>
                                                            Düzenle
                                                        </a>

                                                        <a href="/Category/DeleteCategory/@item.CategoryId"
                                                           class="modern-btn btn-delete"
                                                           onclick="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?');">
                                                            <i class="fas fa-trash-alt"></i>
                                                            Sil
                                                        </a>

                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6"
                                                class="text-center text-muted"
                                                style="padding:30px;">
                                                Görüntülenecek kategori bulunamadı.
                                            </td>
                                        </tr>
                                    }

                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="card-footer"
                         style="background:white;padding:20px;">

                        <i class="fas fa-info-circle"></i>
                        Toplam
                        <strong style="color:#667eea;">
                            @categories.Count
                        </strong>
                        kategori listelendi.
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>

<script>
    (function () {
        function initializeSorting() {
            const tbody = document.getElementById("sortableCategories");
            const message = document.getElementById("orderMessage");

            const token = document.querySelector(
                '#orderTokenForm input[name="__RequestVerificationToken"]'
            );

            if (!tbody || typeof Sortable === "undefined") {
                if (message) {
                    message.className = "alert alert-danger";
                    message.textContent =
                        "Sürükle-bırak kütüphanesi yüklenemedi.";
                }
                return;
            }

            const sortable = new Sortable(tbody, {
                animation: 200,
                draggable: "tr[data-id]",
                handle: ".drag-handle",
                ghostClass: "sortable-ghost",
                chosenClass: "sortable-chosen",

                onEnd: async function (evt) {
                    if (evt.oldIndex === evt.newIndex)
                        return;

                    sortable.option("disabled", true);

                    const rows = Array.from(
                        tbody.querySelectorAll("tr[data-id]")
                    );

                    rows.forEach((row, index) => {
                        const number = row.querySelector(".row-number");
                        if (number)
                            number.textContent = index + 1;
                    });

                    const categoryIds = rows.map(
                        row => Number(row.dataset.id)
                    );

                    if (message) {
                        message.className = "alert alert-info";
                        message.textContent =
                            "Kategori sıralaması kaydediliyor...";
                    }

                    try {
                        if (!token) {
                            throw new Error(
                                "Güvenlik anahtarı bulunamadı.");
                        }

                        const response = await fetch(
                            '@Url.Action("UpdateCategoryOrder", "Category")',
                            {
                                method: "POST",
                                headers: {
                                    "Content-Type": "application/json",
                                    "RequestVerificationToken": token.value
                                },
                                body: JSON.stringify(categoryIds)
                            }
                        );

                        if (!response.ok) {
                            throw new Error(
                                "HTTP " + response.status +
                                ": " + await response.text()
                            );
                        }

                        if (message) {
                            message.className = "alert alert-success";
                            message.textContent =
                                "Kategori sıralaması başarıyla kaydedildi.";
                        }
                    } catch (error) {
                        console.error("Sıralama hatası:", error);

                        if (message) {
                            message.className = "alert alert-danger";
                            message.textContent =
                                "Sıralama kaydedilemedi: " + error.message;
                        }

                        setTimeout(function () {
                            window.location.reload();
                        }, 1500);
                    } finally {
                        sortable.option("disabled", false);
                    }
                }
            });
        }

        if (document.readyState === "loading") {
            document.addEventListener(
                "DOMContentLoaded",
                initializeSorting
            );
        } else {
            initializeSorting();
        }
    })();
</script>
