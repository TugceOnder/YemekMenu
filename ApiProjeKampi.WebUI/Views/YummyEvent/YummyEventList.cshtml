@model List<ResultYummyEventDto>

@{
    ViewData["Title"] = "YummyEventList";
    Layout = "~/Views/AdminLayout/Index.cshtml";

    int count = 0;
    var events = Model ?? new List<ResultYummyEventDto>();
}


<link rel="stylesheet"
      href="~/css/PartialStyle.css"
      asp-append-version="true" />

<section class="section"
    <div class="section-body">
        <div class="row">
            <div class="col-12">

                <div class="card modern-card">

                    <div class="card-header"
                         style="background:white;
                                border-bottom:2px solid #f0f0f0;">

                        <h4 style="color:#667eea;
                                   font-weight:700;
                                   margin:0;">
                            <i class="fas fa-calendar-alt"></i>
                            Etkinlik Organizasyon Listesi
                        </h4>

                        <div class="card-header-action">
                            <a href="/YummyEvent/CreateYummyEvent/"
                               class="modern-btn btn-create">
                                <i class="fas fa-plus"></i>
                                Yeni Organizasyon Ekle
                            </a>
                        </div>
                    </div>

                    <div class="card-body" style="padding:0;">
                        <div class="table-responsive">

                            <table class="table modern-table">
                                <thead>
                                    <tr>
                                        <th style="width:5%;">#</th>
                                        <th style="width:5%;"></th>
                                        <th style="width:18%;">Organizasyon Başlığı</th>
                                        <th style="width:37%;">Açıklama</th>
                                        <th style="width:12%;">Fiyat</th>
                                        <th style="width:23%;"
                                            class="text-center">İşlemler</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in events)
                                    {
                                        count++;

                                        <tr>
                                            <td>
                                                <div class="event-number">
                                                    @count
                                                </div>
                                            </td>

                                            <td>
                                                <div class="event-icon">
                                                    <i class="fas fa-glass-cheers"></i>
                                                </div>
                                            </td>

                                            <td>
                                                <div class="event-title">
                                                    <i class="fas fa-crown"
                                                       style="color:#ffa726; margin-right:5px;"></i>
                                                    @item.Title
                                                </div>
                                            </td>

                                            <td>
                                                <div class="event-description">
                                                    @item.Description
                                                </div>
                                            </td>

                                            <td>
                                                <span class="price-badge">
                                                    <i class="fas fa-lira-sign"></i>
                                                    @item.Price.ToString("N2")
                                                </span>
                                            </td>

                                            <td class="text-center event-action-cell">
                                                <div class="event-actions">

                                                    <!-- GÖRÜNTÜLE -->
                                                    <button type="button"
                                                            class="modern-btn btn-view js-view-event"
                                                            data-title="@item.Title"
                                                            data-description="@item.Description"
                                                            data-price="@item.Price.ToString("N2")"
                                                            title="Görüntüle">
                                                        <i class="fas fa-eye"></i>
                                                        Görüntüle
                                                    </button>

                                                    <!-- DÜZENLE -->
                                                    <a href="/YummyEvent/UpdateYummyEvent/@item.YummyEventId/"
                                                       class="modern-btn btn-edit"
                                                       title="Düzenle">
                                                        <i class="fas fa-edit"></i>
                                                        Düzenle
                                                    </a>

                                                    <!-- SİL -->
                                                    <a href="/YummyEvent/DeleteYummyEvent/@item.YummyEventId/"
                                                       class="modern-btn btn-delete"
                                                       title="Sil"
                                                       onclick="return confirm('Bu etkinliği silmek istediğinize emin misiniz?');">
                                                        <i class="fas fa-trash-alt"></i>
                                                        Sil
                                                    </a>

                                                </div>
                                            </td>
                                        </tr>
                                    }

                                    @if (events.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="6"
                                                class="text-center text-muted"
                                                style="padding:25px;">
                                                Henüz organizasyon eklenmemiş.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                        </div>
                    </div>

                    <div class="card-footer"
                         style="background:white;
                                border-top:2px solid #f0f0f0;">

                        <div style="color:#999; font-size:0.875rem;">
                            <i class="fas fa-info-circle"></i>
                            Toplam
                            <strong style="color:#667eea;">
                                @events.Count
                            </strong>
                            etkinlik organizasyonu listelendi.
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    (function () {

        document.querySelectorAll(".js-view-event").forEach(function (button) {

            button.addEventListener("click", function () {

                const title = this.dataset.title || "";
                const description = this.dataset.description || "";
                const price = this.dataset.price || "";

                const container = document.createElement("div");
                container.className = "event-detail";

                function addDetail(label, value) {

                    const row = document.createElement("div");
                    row.className = "event-detail-row";

                    const labelElement = document.createElement("span");
                    labelElement.className = "event-detail-label";
                    labelElement.textContent = label;

                    const valueElement = document.createElement("p");
                    valueElement.className = "event-detail-value";
                    valueElement.textContent = value || "Belirtilmemiş";

                    row.appendChild(labelElement);
                    row.appendChild(valueElement);

                    container.appendChild(row);
                }

                addDetail("Organizasyon Başlığı", title);
                addDetail("Açıklama", description);
                addDetail("Fiyat", price + " TL");

                if (typeof Swal !== "undefined") {

                    Swal.fire({
                        title: "Etkinlik Organizasyon Detayları",
                        html: container,
                        icon: "info",
                        width: 480,
                        customClass: {
                            popup: "event-popup"
                        },
                        confirmButtonText: "Kapat",
                        confirmButtonColor: "#667eea"
                    });

                } else {

                    alert(
                        "Organizasyon: " + title + "\n\n" +
                        "Açıklama: " + description + "\n\n" +
                        "Fiyat: " + price + " TL"
                    );
                }

            });

        });

    })();
</script>
