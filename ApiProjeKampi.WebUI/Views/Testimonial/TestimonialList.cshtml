@model List<ResultTestimonialDto>

@{
    ViewData["Title"] = "TestimonialList";
    Layout = "~/Views/AdminLayout/Index.cshtml";

    int count = 0;
    var testimonials = Model ?? new List<ResultTestimonialDto>();
}
<link rel="stylesheet"
      href="~/css/PartialStyle.css"
      asp-append-version="true" />

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">

                <div class="card modern-card">

                    <div class="card-header"
                         style="background:white;
                                border-bottom:2px solid #f0f0f0;
                                border-radius:15px 15px 0 0;">

                        <h4 style="color:#667eea; font-weight:700; margin:0;">
                            <i class="fas fa-comments" style="margin-right:10px;"></i>
                            Müşteri Yorumları Listesi
                        </h4>

                        <div class="card-header-action">
                            <a href="/Testimonial/CreateTestimonial/"
                               class="modern-btn btn-create">
                                <i class="fas fa-plus"></i>
                                Yeni Yorum Ekle
                            </a>
                        </div>
                    </div>

                    <div class="card-body" style="padding:0;">
                        <div class="table-responsive">

                            <table class="table modern-table">
                                <thead>
                                    <tr>
                                        <th style="width:5%;">#</th>
                                        <th style="width:15%;">Müşteri Adı</th>
                                        <th style="width:12%;">Unvan</th>
                                        <th style="width:40%;">Yorum</th>
                                        <th style="width:28%;" class="text-center">
                                            İşlemler
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in testimonials)
                                    {
                                        count++;

                                        <tr>
                                            <td>
                                                <div class="customer-number">
                                                    @count
                                                </div>
                                            </td>

                                            <td>
                                                <div class="customer-name">
                                                    <i class="fas fa-user"
                                                       style="color:#667eea; margin-right:5px;"></i>
                                                    @item.nameSurname
                                                </div>
                                            </td>

                                            <td>
                                                <span class="customer-title">
                                                    <i class="fas fa-briefcase"></i>
                                                    @item.title
                                                </span>
                                            </td>

                                            <td>
                                                <div class="comment-box">
                                                    @item.comment
                                                </div>

                                                <div class="rating-stars">
                                                    <i class="fas fa-star"></i>
                                                    <i class="fas fa-star"></i>
                                                    <i class="fas fa-star"></i>
                                                    <i class="fas fa-star"></i>
                                                    <i class="fas fa-star"></i>
                                                </div>
                                            </td>

                                            <td class="text-center testimonial-action-cell">
                                                <div class="testimonial-actions">

                                                    <!-- GÖRÜNTÜLE -->
                                                    <button type="button"
                                                            class="modern-btn btn-view js-view-testimonial"
                                                            data-name="@item.nameSurname"
                                                            data-title="@item.title"
                                                            data-comment="@item.comment"
                                                            data-image="@item.imageUrl"
                                                            title="Görüntüle">

                                                        <i class="fas fa-eye"></i>
                                                        Görüntüle
                                                    </button>

                                                    <!-- DÜZENLE -->
                                                    <a href="/Testimonial/UpdateTestimonial/@item.testimonialId/"
                                                       class="modern-btn btn-edit"
                                                       title="Düzenle">
                                                        <i class="fas fa-edit"></i>
                                                        Düzenle
                                                    </a>

                                                    <!-- SİL -->
                                                    <a href="/Testimonial/DeleteTestimonial/@item.testimonialId/"
                                                       class="modern-btn btn-delete"
                                                       title="Sil"
                                                       onclick="return confirm('Bu yorumu silmek istediğinize emin misiniz?');">
                                                        <i class="fas fa-trash-alt"></i>
                                                        Sil
                                                    </a>

                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                        </div>
                    </div>

                    <div class="card-footer"
                         style="background:white; border-top:2px solid #f0f0f0;">

                        <div style="color:#999; font-size:0.875rem;">
                            <i class="fas fa-info-circle"></i>
                            Toplam
                            <strong style="color:#667eea;">
                                @testimonials.Count
                            </strong>
                            müşteri yorumu listelendi
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    (function () {

        document.querySelectorAll(".js-view-testimonial").forEach(function (button) {

            button.addEventListener("click", function () {

                const name = this.dataset.name || "";
                const title = this.dataset.title || "";
                const comment = this.dataset.comment || "";
                const imageUrl = (this.dataset.image || "").trim();

                const container = document.createElement("div");
                container.className = "testimonial-detail";

                // MÜŞTERİ FOTOĞRAFI
                if (imageUrl) {

                    const image = document.createElement("img");

                    image.src = imageUrl;
                    image.alt = name || "Müşteri fotoğrafı";
                    image.className = "testimonial-detail-image";

                    image.onerror = function () {
                        image.remove();
                    };

                    container.appendChild(image);
                }

                // DETAY SATIRI OLUŞTUR
                function addDetail(label, value) {

                    const row = document.createElement("div");
                    row.className = "testimonial-detail-row";

                    const labelElement = document.createElement("span");
                    labelElement.className = "testimonial-detail-label";
                    labelElement.textContent = label;

                    const valueElement = document.createElement("p");
                    valueElement.className = "testimonial-detail-value";
                    valueElement.textContent = value || "Belirtilmemiş";

                    row.appendChild(labelElement);
                    row.appendChild(valueElement);

                    container.appendChild(row);
                }

                addDetail("Müşteri Adı Soyadı", name);
                addDetail("Unvan", title);
                addDetail("Yorum", comment);

                // SWEETALERT DETAY PENCERESİ
                if (typeof Swal !== "undefined") {

                    Swal.fire({
                        title: "Müşteri Yorumu Detayları",
                        html: container,
                        icon: "info",
                        width: 480,
                        customClass: {
                            popup: "testimonial-popup"
                        },
                        confirmButtonText: "Kapat",
                        confirmButtonColor: "#667eea"
                    });

                } else {

                    alert(
                        "Müşteri: " + name + "\n\n" +
                        "Unvan: " + title + "\n\n" +
                        "Yorum: " + comment
                    );
                }

            });

        });

    })();
</script>
