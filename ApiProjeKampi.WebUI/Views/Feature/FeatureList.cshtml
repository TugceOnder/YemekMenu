@model List<ApiProjeKampi.WebUI.Dtos.FeatureDtos.ResultFeatureDto>

@{
    ViewData["Title"] = "FeatureList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
    var features = Model ?? new List<ApiProjeKampi.WebUI.Dtos.FeatureDtos.ResultFeatureDto>();
}
<link rel="stylesheet"
      href="~/css/PartialStyle.css"
      asp-append-version="true" />


<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card modern-card">

                    <!-- KART BAŞLIĞI -->
                    <div class="card-header"
                         style="background:white;
                                border-bottom:2px solid #f0f0f0;
                                border-radius:15px 15px 0 0;">

                        <h4 style="color:#667eea; font-weight:700; margin:0;">
                            <i class="fas fa-star"
                               style="margin-right:10px;"></i>
                            Öne Çıkan Alan İşlemleri
                        </h4>

                        <div class="card-header-action">

                            @if (features.Count >= 1)
                            {
                                <button class="modern-btn btn-disabled"
                                        disabled>
                                    <i class="fas fa-check-circle"></i>
                                    Feature Mevcut
                                </button>
                            }
                            else
                            {
                                <a href="/Feature/CreateFeature/"
                                   class="modern-btn btn-create">
                                    <i class="fas fa-plus"></i>
                                    Yeni Feature Ekle
                                </a>
                            }

                        </div>
                    </div>

                    <!-- TABLO -->
                    <div class="card-body" style="padding:0;">
                        <div class="table-responsive">

                            <table class="table modern-table">

                                <thead>
                                    <tr>
                                        <th style="width:5%;">#</th>
                                        <th style="width:5%;"></th>
                                        <th style="width:15%;">Başlık</th>
                                        <th style="width:15%;">Alt Başlık</th>
                                        <th style="width:35%;">Açıklama</th>
                                        <th style="width:25%;"
                                            class="text-center">
                                            İşlemler
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in features)
                                    {
                                        count++;

                                        <tr>
                                            <td>
                                                <strong>@count</strong>
                                            </td>

                                            <td>
                                                <div class="feature-icon">
                                                    <i class="fas fa-star"></i>
                                                </div>
                                            </td>

                                            <td>
                                                <span class="title-badge">
                                                    <i class="fas fa-heading"></i>
                                                    @item.Title
                                                </span>
                                            </td>

                                            <td>
                                                <span class="subtitle-text">
                                                    <i class="fas fa-quote-left"></i>
                                                    @item.SubTitle
                                                </span>
                                            </td>

                                            <td>
                                                <div class="description-text">
                                                    <i class="fas fa-align-left"></i>
                                                    @item.Description
                                                </div>
                                            </td>

                                            <td class="text-center">
                                                <div class="feature-actions">

                                                    <!-- GÖRÜNTÜLE -->
                                                    <button type="button"
                                                            class="modern-btn btn-view js-view-feature"
                                                            data-id="@item.FeatureId"
                                                            data-title="@item.Title"
                                                            data-subtitle="@item.SubTitle"
                                                            data-description="@item.Description"
                                                            title="Görüntüle">

                                                        <i class="fas fa-eye"></i>
                                                        Görüntüle
                                                    </button>

                                                    <!-- DÜZENLE -->
                                                    <a href="/Feature/UpdateFeature/@item.FeatureId/"
                                                       class="modern-btn btn-edit"
                                                       title="Düzenle">

                                                        <i class="fas fa-edit"></i>
                                                        Düzenle
                                                    </a>

                                                    <!-- SİL -->
                                                    <a href="/Feature/DeleteFeature/@item.FeatureId/"
                                                       class="modern-btn btn-delete"
                                                       onclick="return confirm('Bu kaydı silmek istediğinize emin misiniz?');"
                                                       title="Sil">

                                                        <i class="fas fa-trash-alt"></i>
                                                        Sil
                                                    </a>

                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>

                            </table>

                        </div>

                        @if (features.Count == 1)
                        {
                            <div style="padding:1rem;">
                                <div class="alert-info-custom">
                                    <i class="fas fa-info-circle"
                                       style="font-size:1.5rem;"></i>

                                    <div>
                                        <strong>Bilgilendirme:</strong>
                                        Sistemde zaten bir feature kaydı
                                        bulunmaktadır. Yeni feature eklemek
                                        için önce mevcut kaydı silmeniz
                                        gerekmektedir.
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- ALT BİLGİ -->
                    <div class="card-footer"
                         style="background:white;
                                border-top:2px solid #f0f0f0;">

                        <div style="color:#999; font-size:0.875rem;">
                            <i class="fas fa-info-circle"></i>
                            Toplam
                            <strong style="color:#667eea;">
                                @features.Count
                            </strong>
                            feature kaydı listelendi.
                        </div>

                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    // GÖRÜNTÜLE BUTONU - SWEETALERT DETAY PENCERESİ

    document.querySelectorAll(".js-view-feature").forEach(function (button) {

        button.addEventListener("click", function () {

            const title = this.dataset.title || "";
            const subtitle = this.dataset.subtitle || "";
            const description = this.dataset.description || "";

            // Güvenli şekilde HTML elemanları oluştur
            const container = document.createElement("div");
            container.className = "feature-detail";

            function addDetail(label, value) {
                const row = document.createElement("div");
                row.className = "feature-detail-row";

                const labelElement = document.createElement("span");
                labelElement.className = "feature-detail-label";
                labelElement.textContent = label;

                const valueElement = document.createElement("p");
                valueElement.className = "feature-detail-value";
                valueElement.textContent = value || "Belirtilmemiş";

                row.appendChild(labelElement);
                row.appendChild(valueElement);
                container.appendChild(row);
            }

            addDetail("Başlık", title);
            addDetail("Alt Başlık", subtitle);
            addDetail("Açıklama", description);

            if (typeof Swal !== "undefined") {
                Swal.fire({
                    title: "Öne Çıkan Alan Detayları",
                    html: container,
                    icon: "info",
                    width: 650,
                    confirmButtonText: "Kapat",
                    confirmButtonColor: "#667eea"
                });
            } else {
                alert(
                    "Başlık: " + title + "\n\n" +
                    "Alt Başlık: " + subtitle + "\n\n" +
                    "Açıklama: " + description
                );
            }

        });

    });
</script>
