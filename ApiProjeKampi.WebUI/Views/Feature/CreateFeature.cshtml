@model ApiProjeKampi.WebUI.Dtos.FeatureDtos.CreateFeatureDto

@{
    ViewData["Title"] = "CreateFeature";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<style>
    .feature-upload-area {
        padding: 20px;
        border: 2px dashed #667eea;
        border-radius: 12px;
        background: #f8f9ff;
    }

        .feature-upload-area input[type="file"] {
            display: block !important;
            width: 100%;
            padding: 10px;
            background: white;
            border: 1px solid #ddd;
            border-radius: 8px;
        }

    .feature-preview {
        width: 240px;
        max-width: 100%;
        height: 160px;
        margin-top: 15px;
        object-fit: cover;
        border-radius: 10px;
    }
</style>

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Öne Çıkan Alan Ekleme Sayfası</h4>
                    </div>

                    <div class="card-body">
                        <form id="featureForm"
                              action="/Feature/CreateFeature"
                              method="post"
                              enctype="multipart/form-data"
                              novalidate>

                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3"></div>

                            <div class="form-group">
                                <label>Başlık</label>
                                <input asp-for="Title"
                                       class="form-control" />
                            </div>

                            <div class="form-group">
                                <label>Alt Başlık</label>
                                <input asp-for="SubTitle"
                                       class="form-control" />
                            </div>

                            <div class="form-group">
                                <label>Açıklama</label>
                                <textarea asp-for="Description"
                                          rows="4"
                                          class="form-control"></textarea>
                            </div>

                            <div class="form-group">
                                <label>Görsel</label>

                                <div class="feature-upload-area">
                                    <p>
                                        Bilgisayardan veya telefondan
                                        fotoğraf seçiniz.
                                    </p>

                                    <input type="file"
                                           id="imageFile"
                                           name="imageFile"
                                           accept=".jpg,.jpeg,.png,.webp" />

                                    <small class="text-muted">
                                        JPG, PNG veya WEBP — maksimum 5 MB.
                                    </small>

                                    <div class="text-danger mt-2">
                                        @Html.ValidationMessage("imageFile")
                                    </div>

                                    <img id="imagePreview"
                                         class="feature-preview"
                                         alt="Görsel önizleme"
                                         style="display:none;" />

                                    <div>
                                        <button type="button"
                                                id="removeImageBtn"
                                                class="btn btn-danger mt-3"
                                                style="display:none;">
                                            <i class="fas fa-trash"></i>
                                            Seçilen Fotoğrafı Kaldır
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <button type="submit"
                                    class="btn btn-success">
                                <i class="fas fa-save"></i>
                                Öne Çıkan Alanı Kaydet
                            </button>

                            <a href="/Feature/FeatureList"
                               class="btn btn-secondary">
                                Geri Dön
                            </a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    (function () {
        const form = document.getElementById("featureForm");
        const input = document.getElementById("imageFile");
        const preview = document.getElementById("imagePreview");
        const removeBtn = document.getElementById("removeImageBtn");

        let objectUrl = null;

        function showAlert(message) {
            return Swal.fire({
                icon: "warning",
                title: "Eksik veya Hatalı Bilgi",
                text: message,
                confirmButtonText: "Tamam",
                confirmButtonColor: "#667eea"
            });
        }

        function clearPreview() {
            if (objectUrl) {
                URL.revokeObjectURL(objectUrl);
                objectUrl = null;
            }

            preview.removeAttribute("src");
            preview.style.display = "none";
            removeBtn.style.display = "none";
        }

        input.addEventListener("change", function () {
            clearPreview();

            const file = input.files[0];
            if (!file) return;

            const extension = file.name.split(".").pop().toLowerCase();

            if (!["jpg", "jpeg", "png", "webp"].includes(extension)) {
                input.value = "";
                showAlert("Yalnızca JPG, PNG veya WEBP fotoğraf seçebilirsiniz.");
                return;
            }

            if (file.size > 5 * 1024 * 1024) {
                input.value = "";
                showAlert("Fotoğraf en fazla 5 MB olabilir.");
                return;
            }

            objectUrl = URL.createObjectURL(file);
            preview.src = objectUrl;
            preview.style.display = "block";
            removeBtn.style.display = "inline-block";
        });

        removeBtn.addEventListener("click", function () {
            input.value = "";
            clearPreview();
        });

        form.addEventListener("submit", function (event) {
            const title = document.getElementById("Title").value.trim();
            const subTitle = document.getElementById("SubTitle").value.trim();
            const description = document.getElementById("Description").value.trim();
            const file = input.files[0];

            let message = "";

            if (!title)
                message = "Başlık alanını doldurunuz.";
            else if (!subTitle)
                message = "Alt başlık alanını doldurunuz.";
            else if (!description)
                message = "Açıklama alanını doldurunuz.";
            else if (!file)
                message = "Lütfen bir fotoğraf seçiniz.";

            if (message) {
                event.preventDefault();
                showAlert(message);
            }
        });
    })();
</script>
