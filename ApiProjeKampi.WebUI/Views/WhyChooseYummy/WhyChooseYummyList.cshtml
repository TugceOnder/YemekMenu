@model List<ApiProjeKampi.WebUI.Dtos.WhyChooseYummyDtos.ResultWhyChooseYummyDto>

@{
    ViewData["Title"] = "WhyChooseYummyList";
    Layout = "~/Views/AdminLayout/Index.cshtml";

    int count = 0;

    var items = Model ??
        new List<ApiProjeKampi.WebUI.Dtos.WhyChooseYummyDtos.ResultWhyChooseYummyDto>();
}

<link rel="stylesheet"
      href="~/css/PartialStyle.css"
      asp-append-version="true" />


<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">

                <div class="card modern-card">

                    <!-- KART BAŞLIĞI -->
                    <div class="card-header"
                         style="background:white;
                                border-bottom:2px solid #f0f0f0;
                                border-radius:15px 15px 0 0;">

                        <h4 style="color:#667eea;
                                   font-weight:700;
                                   margin:0;">

                            <i class="fas fa-thumbs-up"
                               style="margin-right:10px;"></i>

                            Neden Bizi Seçmelisiniz Listesi
                        </h4>

                        <div class="card-header-action">

                            <a href="/WhyChooseYummy/CreateWhyChooseYummy/"
                               class="modern-btn btn-create">

                                <i class="fas fa-plus"></i>
                                Yeni Alan Ekle
                            </a>

                        </div>
                    </div>

                    <!-- TABLO -->
                    <div class="card-body" style="padding:0;">

                        <div class="table-responsive">

                            <table class="table modern-table">

                                <thead>
                                    <tr>
                                        <th style="width:5%;">#</th>
                                        <th style="width:5%;"></th>
                                        <th style="width:20%;">Başlık</th>
                                        <th style="width:40%;">Açıklama</th>
                                        <th style="width:30%;"
                                            class="text-center">
                                            İşlemler
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in items)
                                    {
                                        count++;

                                        <tr>
                                            <!-- SIRA NUMARASI -->
                                            <td>
                                                <div class="service-number">
                                                    @count
                                                </div>
                                            </td>

                                            <!-- İKON -->
                                            <td>
                                                <div class="service-icon">
                                                    <i class="fas fa-heart"></i>
                                                </div>
                                            </td>

                                            <!-- BAŞLIK -->
                                            <td>
                                                <div class="title-text">
                                                    <i class="fas fa-check-circle"
                                                       style="color:#43e97b;
                                                                  margin-right:5px;"></i>

                                                    @item.Title
                                                </div>
                                            </td>

                                            <!-- AÇIKLAMA -->
                                            <td>
                                                <div class="description-text">
                                                    <i class="fas fa-quote-left"
                                                       style="color:#ccc;
                                                                  font-size:0.8rem;"></i>

                                                    @item.Description
                                                </div>
                                            </td>

                                            <!-- İŞLEMLER -->
                                            <td class="text-center why-action-cell">

                                                <div class="why-actions">

                                                    <!-- GÖRÜNTÜLE -->
                                                    <button type="button"
                                                            class="modern-btn btn-view js-view-why"
                                                            data-title="@item.Title"
                                                            data-description="@item.Description"
                                                            data-icon="@item.IconUrl"
                                                            title="Görüntüle">

                                                        <i class="fas fa-eye"></i>
                                                        Görüntüle
                                                    </button>

                                                    <!-- DÜZENLE -->
                                                    <a href="/WhyChooseYummy/UpdateWhyChooseYummy/@item.ServiceId/"
                                                       class="modern-btn btn-edit"
                                                       title="Düzenle">

                                                        <i class="fas fa-edit"></i>
                                                        Düzenle
                                                    </a>

                                                    <!-- SİL -->
                                                    <a href="/WhyChooseYummy/DeleteWhyChooseYummy/@item.ServiceId/"
                                                       class="modern-btn btn-delete"
                                                       title="Sil"
                                                       onclick="return confirm('Bu öğeyi silmek istediğinize emin misiniz?');">

                                                        <i class="fas fa-trash-alt"></i>
                                                        Sil
                                                    </a>

                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>

                            </table>
                        </div>
                    </div>

                    <!-- ALT BİLGİ -->
                    <div class="card-footer"
                         style="background:white;
                                border-top:2px solid #f0f0f0;">

                        <div style="color:#999; font-size:0.875rem;">

                            <i class="fas fa-info-circle"></i>

                            Toplam

                            <strong style="color:#667eea;">
                                @items.Count
                            </strong>

                            özellik listelendi.
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    (function () {

        document.querySelectorAll(".js-view-why").forEach(function (button) {

            button.addEventListener("click", function () {

                const title = this.dataset.title || "";
                const description = this.dataset.description || "";
                const iconValue = (this.dataset.icon || "").trim();

                const container = document.createElement("div");
                container.className = "why-detail";

                // KÜÇÜK GÖRSEL VEYA ESKİ İKON
                if (iconValue) {

                    const isImage =
                        iconValue.startsWith("/") ||
                        /^https?:\/\//i.test(iconValue);

                    if (isImage) {

                        const image = document.createElement("img");

                        image.src = iconValue;
                        image.alt = title || "Hizmet görseli";
                        image.className = "why-detail-image";

                        image.onerror = function () {
                            image.remove();
                        };

                        container.appendChild(image);

                    } else {

                        // ESKİ CSS İKONLARI
                        const iconArea = document.createElement("div");
                        iconArea.className = "why-detail-icon";

                        const icon = document.createElement("i");

                        const classes = iconValue
                            .split(/\s+/)
                            .filter(x => /^[a-zA-Z0-9_-]+$/.test(x));

                        icon.className = classes.join(" ");

                        iconArea.appendChild(icon);
                        container.appendChild(iconArea);
                    }
                }

                // DETAY SATIRLARI
                function addDetail(label, value) {

                    const row = document.createElement("div");
                    row.className = "why-detail-row";

                    const labelElement = document.createElement("span");
                    labelElement.className = "why-detail-label";
                    labelElement.textContent = label;

                    const valueElement = document.createElement("p");
                    valueElement.className = "why-detail-value";
                    valueElement.textContent = value || "Belirtilmemiş";

                    row.appendChild(labelElement);
                    row.appendChild(valueElement);

                    container.appendChild(row);
                }

                addDetail("Başlık", title);
                addDetail("Açıklama", description);

                // SWEETALERT DETAY PENCERESİ
                if (typeof Swal !== "undefined") {

                    Swal.fire({
                        title: "Neden Bizi Seçmelisiniz Detayları",
                        html: container,
                        icon: "info",
                        width: 480,
                        customClass: {
                            popup: "why-popup"
                        },
                        confirmButtonText: "Kapat",
                        confirmButtonColor: "#667eea"
                    });

                } else {

                    alert(
                        "Başlık: " + title + "\n\n" +
                        "Açıklama: " + description
                    );
                }

            });

        });

    })();
</script>
