@model CreateChefDto

@{
    ViewData["Title"] = "CreateChef";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12 col-md-12 col-lg-12">

                <div class="card">
                    <div class="card-header">
                        <h4>Yeni Şef Ekleme Sayfası</h4>
                    </div>

                    <div class="card-body">

                        <form asp-controller="Chef"
                              asp-action="CreateChef"
                              method="post"
                              enctype="multipart/form-data">

                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="All"
                                 class="text-danger mb-3"></div>

                            <label>Şef Adı Soyadı</label>
                            <input asp-for="NameSurname"
                                   type="text"
                                   class="form-control"
                                   required />
                            <br />

                            <label>Şef Unvan/Başlık</label>
                            <input asp-for="Title"
                                   type="text"
                                   class="form-control"
                                   required />
                            <br />

                            <label>Açıklama Bilgisi</label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"></textarea>
                            <br />

                            <label>Şef Fotoğrafı Seç</label>
                            <input type="file"
                                   id="chefImage"
                                   name="imageFile"
                                   class="form-control"
                                   accept="image/jpeg,image/png,image/webp"
                                   required />

                            <small class="form-text text-muted">
                                Bilgisayarınızdan veya telefonunuzdan
                                bir fotoğraf seçebilirsiniz. Maksimum 5 MB.
                            </small>

                            <div class="mt-3">
                                <img id="chefPreview"
                                     alt="Şef Fotoğrafı"
                                     style="display:none;
                                            max-width:250px;
                                            max-height:250px;
                                            object-fit:cover;
                                            border-radius:10px;" />
                            </div>

                            <input type="hidden" asp-for="ImageUrl" />

                            <div class="mt-4">

                                <button type="submit"
                                        class="btn btn-primary">
                                    <i class="fas fa-save"></i>
                                    Şefi Kaydet
                                </button>

                                <a href="@Url.Action("ChefList", "Chef")"
                                   class="btn btn-secondary ml-2">
                                    <i class="fas fa-arrow-left"></i>
                                    Geri Dön
                                </a>

                            </div>

                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const input = document.getElementById("chefImage");
        const preview = document.getElementById("chefPreview");

        let previewUrl = null;

        input.addEventListener("change", function () {

            if (previewUrl) {
                URL.revokeObjectURL(previewUrl);
                previewUrl = null;
            }

            const file = input.files[0];

            if (!file) {
                preview.style.display = "none";
                preview.removeAttribute("src");
                return;
            }

            if (file.size > 5 * 1024 * 1024) {
                alert("Fotoğraf en fazla 5 MB olabilir.");
                input.value = "";
                preview.style.display = "none";
                return;
            }

            previewUrl = URL.createObjectURL(file);
            preview.src = previewUrl;
            preview.style.display = "block";
        });
    });
</script>
